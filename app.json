{
  "expo": {
    "name": "Facturiion",
    "slug": "factrion",
    "version": "1.1.19",
    "orientation": "portrait",
    "newArchEnabled": true,
    "scheme": "factrion",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 34,
      "adaptiveIcon": {
        "backgroundColor": "#00030D",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.factrion"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
